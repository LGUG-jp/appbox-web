<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <remove name="Pragma" />
        <remove name="X-Content-Type-Options" />

        <!--
          共通アセットは全ツールが参照するため、
          更新の取りこぼしが最も起きやすい箇所です。
          no-cache（毎回サーバーへ再検証）にすることで、
          各ツールの ?v= を上げ忘れても古いCSSが残りません。
          ファイルは数十KBなので再検証の負荷は問題になりません。
        -->
        <add
          name="Cache-Control"
          value="no-cache, must-revalidate"
        />

        <add
          name="Pragma"
          value="no-cache"
        />

        <add
          name="X-Content-Type-Options"
          value="nosniff"
        />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
