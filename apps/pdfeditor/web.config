<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".mjs" />
      <mimeMap
        fileExtension=".mjs"
        mimeType="text/javascript"
      />

      <remove fileExtension=".wasm" />
      <mimeMap
        fileExtension=".wasm"
        mimeType="application/wasm"
      />

      <remove fileExtension=".woff2" />
      <mimeMap
        fileExtension=".woff2"
        mimeType="font/woff2"
      />

      <remove fileExtension=".gz" />
      <mimeMap
        fileExtension=".gz"
        mimeType="application/gzip"
      />
</staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="Content-Security-Policy" />
        <remove name="Referrer-Policy" />
        <remove name="X-Content-Type-Options" />
        <remove name="X-Frame-Options" />
        <remove name="Permissions-Policy" />
        <remove name="Cache-Control" />
        <remove name="Pragma" />

        <add
          name="Content-Security-Policy"
          value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-src 'none'; media-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        />

        <add
          name="Referrer-Policy"
          value="no-referrer"
        />

        <add
          name="X-Content-Type-Options"
          value="nosniff"
        />

        <add
          name="X-Frame-Options"
          value="DENY"
        />

        <add
          name="Permissions-Policy"
          value="camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
        />

        <add
          name="Cache-Control"
          value="no-store, no-cache, must-revalidate"
        />

        <add
          name="Pragma"
          value="no-cache"
        />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
